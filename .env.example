# Copy to .env (never commit .env) and export the variables before running the scripts.

# --- YouTube Data API v3 (video_pipeline/youtube_upload.py and every script that imports it) ---
# OAuth client of a Google Cloud project with the YouTube Data API enabled, and a refresh token
# obtained once for the channel's Google account (scope youtube.upload / youtube).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# The channel's UC... id (dashboard/server.py; the upload scripts take it as a CLI argument)
YOUTUBE_CHANNEL_ID=

# --- ElevenLabs (scripts/el_tool.py, scripts/sfx_tool.py) ---
ELEVENLABS_API_KEY=
# optional: another voice than the default premade voice
ELEVENLABS_VOICE_ID=

# --- Fish Audio Drama 3 on Hugging Face (scripts/tts_fish.py, scripts/voice/design_leo.py) ---
# HF_TOKEN is read by huggingface_hub (or log in once with `hf auth login`)
HF_TOKEN=
# your private copy of the fishaudio/Drama-3 Space that exposes the /speak API, e.g. my-user/leo-drama3
FISH_SPACE=

# --- Optional paths ---
# folder with the music beds (<track>.mp3 + music_library.json); default: ./music
LEO_MUSIC_DIR=
# bold TTF used for captions, hook text and thumbnails; default: C:\Windows\Fonts\ariblk.ttf (Arial Black)
LEO_FONT=
# ffmpeg / ffprobe executables when they are not on PATH
FFMPEG=
FFPROBE=
FFMPEG_DIR=
# interpreter that has the TTS packages, used by ro_cut.py to call tts_fish.py; default: the current python
TTS_PYTHON=
# language of the local Whisper check (en | ro), scripts/voice/asr_check.py
LEO_LANG=en
# optional JSON file with a Meta Graph API page token for the dashboard's Instagram follower count
META_CONNECTION_FILE=
